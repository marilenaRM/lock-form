{% extends 'base.html.twig' %}

{% set params = {protection: protection ? '1' : '0', live: live ? '1' : '0'} %}
{% set editor_route = live ? 'product_live_edit' : 'product_edit' %}

{% block body %}
<header class="demo-header">
    <h1>{{ 'demo.title'|trans }}</h1>
    <p>{{ 'demo.intro'|trans }}</p>

    <div class="demo-controls">
        <nav class="toggle" aria-label="{{ 'demo.protection.label'|trans }}">
            <a href="{{ path('demo', params|merge({protection: '1'})) }}" class="toggle-option{{ protection ? ' is-active' }}" {% if protection %}aria-current="page"{% endif %}>{{ 'demo.protection.on'|trans }}</a>
            <a href="{{ path('demo', params|merge({protection: '0'})) }}" class="toggle-option{{ not protection ? ' is-active' }}" {% if not protection %}aria-current="page"{% endif %}>{{ 'demo.protection.off'|trans }}</a>
        </nav>
        <nav class="toggle" aria-label="{{ 'demo.mode.label'|trans }}">
            <a href="{{ path('demo', params|merge({live: '0'})) }}" class="toggle-option{{ not live ? ' is-active' }}" {% if not live %}aria-current="page"{% endif %}>{{ 'demo.mode.classic'|trans }}</a>
            <a href="{{ path('demo', params|merge({live: '1'})) }}" class="toggle-option{{ live ? ' is-active' }}" {% if live %}aria-current="page"{% endif %}>{{ 'demo.mode.live'|trans }}</a>
        </nav>
        <form method="post" action="{{ path('demo_reset', params) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('demo_reset') }}">
            <button type="submit" class="button-secondary">{{ 'demo.reset'|trans }}</button>
        </form>
        <a href="{{ path('product_list') }}">{{ 'demo.links.products'|trans }}</a>
        {{ include('_language_switcher.html.twig') }}
    </div>

    <p class="protection-note {{ protection ? 'is-on' : 'is-off' }}">
        {{ (protection ? 'demo.protection.enabled_note' : 'demo.protection.disabled_note')|trans }}
    </p>
    {% if live %}<p class="mode-note">{{ 'demo.mode.live_note'|trans }}</p>{% endif %}
</header>

<main class="demo-grid">
    {% for user in ['alice', 'bob'] %}
        <section class="editor editor-{{ user }}" aria-labelledby="editor-{{ user }}-title">
            <h2 id="editor-{{ user }}-title">{{ ('demo.user.' ~ user)|trans }}</h2>
            <iframe name="{{ user }}" title="{{ ('demo.user.' ~ user)|trans }}" data-editor
                    src="{{ path(editor_route, {id: product.id, as: user, protection: params.protection}) }}"></iframe>
            <p class="editor-links">
                <a href="{{ path(editor_route, {id: product.id, as: user, protection: params.protection}) }}" target="{{ user }}">{{ 'demo.links.reload'|trans }}</a>
                <a href="{{ path('product_stock', {id: product.id, as: user}) }}" target="{{ user }}">{{ 'demo.links.stock'|trans }}</a>
            </p>
        </section>
    {% endfor %}

    <section class="steps" aria-labelledby="steps-title">
        <h2 id="steps-title">{{ 'demo.steps.title'|trans }}</h2>
        <ol>
            <li>{{ 'demo.steps.1'|trans }}</li>
            <li>{{ 'demo.steps.2'|trans }}</li>
            <li>{{ 'demo.steps.3'|trans }}</li>
            <li>{{ 'demo.steps.4'|trans }}</li>
        </ol>
        <h3>{{ 'demo.scenarios.title'|trans }}</h3>
        <ul>
            <li>{{ 'demo.scenarios.stock'|trans }}</li>
            <li>{{ 'demo.scenarios.take_value'|trans }}</li>
            <li>{{ 'demo.scenarios.same_value'|trans }}</li>
            <li>{{ 'demo.scenarios.tag'|trans }}</li>
            <li>{{ 'demo.scenarios.filter'|trans }}</li>
        </ul>
    </section>

    <section class="history" aria-labelledby="history-title">
        <h2 id="history-title">{{ 'history.title'|trans }}</h2>
        <iframe name="history" title="{{ 'history.title'|trans }}" data-history src="{{ path('product_history', {id: product.id}) }}"></iframe>
    </section>
</main>
{% endblock %}
