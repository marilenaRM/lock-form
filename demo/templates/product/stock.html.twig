{% extends 'base.html.twig' %}

{% block body_class %}frame frame-{{ as.value }}{% endblock %}

{% block body %}
<main>
    <p class="editing-as">{{ 'demo.editing_as'|trans({'%user%': as.labelKey|trans}) }}</p>
    <h1 class="frame-title">{{ 'product.stock.title'|trans({'%name%': product.name}) }}</h1>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.stock) }}
        <button type="submit">{{ 'product.save'|trans }}</button>
    {{ form_end(form) }}
</main>
{% endblock %}
