<div {{ attributes }}>
    {{ form_start(form, {attr: {'data-action': 'live#action:prevent', 'data-live-action-param': 'save'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.priceInCents) }}
        {{ form_row(form.status) }}
        {{ form_row(form.category) }}
        {{ form_row(form.tags) }}
        {% if form._concurrency_token_acknowledged is defined %}
            <div class="acknowledgement">{{ form_row(form._concurrency_token_acknowledged) }}</div>
        {% endif %}
        <button type="submit">{{ 'product.save'|trans }}</button>
    {{ form_end(form) }}
</div>
