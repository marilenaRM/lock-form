{
    "name": "lock-form/demo",
    "description": "Demo application for lock-form/form-concurrency: two people editing the same record",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo_sqlite": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "lock-form/form-concurrency": "*@dev",
        "symfony/clock": "^7.3",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/form": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/security-csrf": "^7.3",
        "symfony/translation": "^7.3",
        "symfony/twig-bundle": "^7.3",
        "symfony/ux-live-component": "^2.30",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^7.3",
        "symfony/css-selector": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "scripts": {
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "qa": [
            "@stan",
            "@test"
        ]
    }
}
