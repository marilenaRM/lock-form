        <body>
            <trans-unit id="demo.title">
                <source>demo.title</source>
                <target>Deux personnes, une même fiche</target>
            </trans-unit>
            <trans-unit id="demo.intro">
                <source>demo.intro</source>
                <target>Alice et Bob modifient le même produit en même temps. Suivez les étapes, avec et sans la protection, et regardez l’historique des enregistrements.</target>
            </trans-unit>
            <trans-unit id="demo.protection.label">
                <source>demo.protection.label</source>
                <target>Protection contre les éditions concurrentes</target>
            </trans-unit>
            <trans-unit id="demo.protection.on">
                <source>demo.protection.on</source>
                <target>Protection activée</target>
            </trans-unit>
            <trans-unit id="demo.protection.off">
                <source>demo.protection.off</source>
                <target>Protection désactivée</target>
            </trans-unit>
            <trans-unit id="demo.protection.enabled_note">
                <source>demo.protection.enabled_note</source>
                <target>Protection activée : un enregistrement fait à partir d’une version périmée est refusé, et les champs modifiés affichent ce qui est en base.</target>
            </trans-unit>
            <trans-unit id="demo.protection.disabled_note">
                <source>demo.protection.disabled_note</source>
                <target>Protection désactivée : le dernier à enregistrer gagne, sans prévenir personne.</target>
            </trans-unit>
            <trans-unit id="demo.reset">
                <source>demo.reset</source>
                <target>Réinitialiser la démo</target>
            </trans-unit>
            <trans-unit id="demo.empty">
                <source>demo.empty</source>
                <target>La base de la démo est vide.</target>
            </trans-unit>
