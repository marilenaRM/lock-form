                <source>demo.user.alice</source>
                <target>Alice</target>
            </trans-unit>
            <trans-unit id="demo.user.bob">
                <source>demo.user.bob</source>
                <target>Bob</target>
            </trans-unit>
            <trans-unit id="demo.editing_as">
                <source>demo.editing_as</source>
                <target>Vous êtes %user%.</target>
            </trans-unit>
            <trans-unit id="demo.links.products">
                <source>demo.links.products</source>
                <target>Liste des produits (filtre GET)</target>
            </trans-unit>
            <trans-unit id="demo.links.reload">
                <source>demo.links.reload</source>
                <target>Recharger le formulaire produit</target>
            </trans-unit>
            <trans-unit id="demo.links.stock">
                <source>demo.links.stock</source>
                <target>Ajuster plutôt le stock</target>
            </trans-unit>
