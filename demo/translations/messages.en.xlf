        <body>
            <trans-unit id="demo.title">
                <source>demo.title</source>
                <target>Two people, one record</target>
            </trans-unit>
            <trans-unit id="demo.intro">
                <source>demo.intro</source>
                <target>Alice and Bob edit the same product at the same time. Follow the steps, with and without the protection, and watch the save history.</target>
            </trans-unit>
            <trans-unit id="demo.protection.label">
                <source>demo.protection.label</source>
                <target>Concurrent-edit protection</target>
            </trans-unit>
            <trans-unit id="demo.protection.on">
                <source>demo.protection.on</source>
                <target>Protection on</target>
            </trans-unit>
            <trans-unit id="demo.protection.off">
                <source>demo.protection.off</source>
                <target>Protection off</target>
            </trans-unit>
            <trans-unit id="demo.protection.enabled_note">
                <source>demo.protection.enabled_note</source>
                <target>Protection on: a save based on an outdated version is refused, and the changed fields show what is stored now.</target>
            </trans-unit>
            <trans-unit id="demo.protection.disabled_note">
                <source>demo.protection.disabled_note</source>
                <target>Protection off: the last one to save wins, silently.</target>
            </trans-unit>
            <trans-unit id="demo.reset">
                <source>demo.reset</source>
                <target>Reset the demo</target>
            </trans-unit>
