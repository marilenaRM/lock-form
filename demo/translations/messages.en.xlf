                <target>Both forms are open on the same version of the product.</target>
            </trans-unit>
            <trans-unit id="demo.steps.2">
                <source>demo.steps.2</source>
                <target>Bob changes the price and saves.</target>
            </trans-unit>
            <trans-unit id="demo.steps.3">
                <source>demo.steps.3</source>
                <target>Alice, who still sees the old price, changes the name and saves.</target>
            </trans-unit>
            <trans-unit id="demo.steps.4">
                <source>demo.steps.4</source>
                <target>Protection off: the history shows Alice putting the old price back without knowing it. Protection on: Alice is told the price changed and sees Bob’s value; her name is kept, and saving again is her decision.</target>
            </trans-unit>
            <trans-unit id="demo.scenarios.title">
                <source>demo.scenarios.title</source>
                <target>Also worth trying</target>
            </trans-unit>
            <trans-unit id="demo.scenarios.stock">
                <source>demo.scenarios.stock</source>
                <target>Bob adjusts the stock, then Alice saves: no conflict, her form does not show the stock.</target>
            </trans-unit>
            <trans-unit id="demo.scenarios.same_value">
                <source>demo.scenarios.same_value</source>
                <target>Bob saves without changing anything: Alice is not bothered.</target>
            </trans-unit>
            <trans-unit id="demo.scenarios.tag">
                <source>demo.scenarios.tag</source>
                <target>Bob adds a tag: Alice is told the tag list changed.</target>
