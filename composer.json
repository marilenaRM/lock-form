{
    "name": "lock-form/form-concurrency",
    "description": "Detects concurrent edits on Symfony forms with an automatic, storage-agnostic fingerprint token",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "symfony/config": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/form": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/translation-contracts": "^3.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/cache": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/routing": "^7.3",
        "symfony/security-core": "^7.3",
        "symfony/translation": "^7.3"
    },
    "suggest": {
        "symfony/cache": "For the presence indicator (form_concurrency.presence): where open tabs are kept",
        "symfony/routing": "For the presence indicator: the heartbeat route",
        "symfony/security-bundle": "For the presence indicator: names the logged-in user, unless you provide a PresenceIdentity"
    },
    "autoload": {
        "psr-4": {
            "LockForm\\FormConcurrency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LockForm\\FormConcurrency\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false
        }
    },
    "scripts": {
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "qa": [
            "@stan",
            "@test"
        ]
    }
}
