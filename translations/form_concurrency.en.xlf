<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
        <body>
            <trans-unit id="form_concurrency.conflict">
                <source>form_concurrency.conflict</source>
                <target>Someone else saved this record while you were editing it. The fields marked below were changed: take their current value, or tick the confirmation box to save your values anyway.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.field_changed">
                <source>form_concurrency.field_changed</source>
                <target>Changed by someone else since you opened the form.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.field_changed_to">
                <source>form_concurrency.field_changed_to</source>
                <target>Changed by someone else since you opened the form. Current value: {{ value }}</target>
            </trans-unit>
            <trans-unit id="form_concurrency.field_cleared">
                <source>form_concurrency.field_cleared</source>
                <target>Cleared by someone else since you opened the form.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.entries_changed">
                <source>form_concurrency.entries_changed</source>
                <target>{{ field }}: entries were added or removed by someone else since you opened the form.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.acknowledge">
                <source>form_concurrency.acknowledge</source>
                <target>I have reviewed these changes: save my values anyway.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.presence.someone">
                <source>form_concurrency.presence.someone</source>
                <target>Someone else is also editing this record.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.presence.one">
                <source>form_concurrency.presence.one</source>
                <target>{{ name }} is also editing this record.</target>
            </trans-unit>
            <trans-unit id="form_concurrency.presence.many">
                <source>form_concurrency.presence.many</source>
                <target>{{ names }} are also editing this record.</target>
            </trans-unit>
        </body>
